From 01aebbe6fe4f5d43bce91a0770e59b00eb29214a Mon Sep 17 00:00:00 2001
From: Deniz <100004271+uwuv3@users.noreply.github.com>
Date: Wed, 29 Oct 2025 15:08:07 +0000
Subject: [PATCH 3/5] Hot kernel

---
 fs/exec.c | 2 ++
 fs/open.c | 1 +
 fs/stat.c | 1 +
 3 files changed, 4 insertions(+)

diff --git a/fs/exec.c b/fs/exec.c
index 1a7d3faff833..5964de3cdab0 100644
--- a/fs/exec.c
+++ b/fs/exec.c
@@ -1880,8 +1880,10 @@ static int do_execveat_common(int fd, struct filename *filename,
 
 #if defined(CONFIG_KSU) && !defined(CONFIG_KSU_WITH_KPROBES)
 extern bool ksu_execveat_hook __read_mostly;
+__attribute__((hot))
 extern int ksu_handle_execveat(int *fd, struct filename **filename_ptr, void *argv,
 			void *envp, int *flags);
+__attribute__((hot))
 extern int ksu_handle_execveat_sucompat(int *fd, struct filename **filename_ptr,
 				 void *argv, void *envp, int *flags);
 #endif
diff --git a/fs/open.c b/fs/open.c
index 162e23594193..c5d47be5216d 100644
--- a/fs/open.c
+++ b/fs/open.c
@@ -355,6 +355,7 @@ SYSCALL_DEFINE4(fallocate, int, fd, int, mode, loff_t, offset, loff_t, len)
 }
 
 #if defined(CONFIG_KSU) && !defined(CONFIG_KSU_WITH_KPROBES)
+__attribute__((hot))
 extern int ksu_handle_faccessat(int *dfd, const char __user **filename_user, int *mode,
 			                    int *flags);
 #endif
diff --git a/fs/stat.c b/fs/stat.c
index 7c483282fbed..940ea9560538 100644
--- a/fs/stat.c
+++ b/fs/stat.c
@@ -354,6 +354,7 @@ SYSCALL_DEFINE2(newlstat, const char __user *, filename,
 }
 
 #if defined(CONFIG_KSU) && !defined(CONFIG_KSU_WITH_KPROBES)
+__attribute__((hot))
 extern int ksu_handle_stat(int *dfd, const char __user **filename_user, int *flags);
 #endif
 
